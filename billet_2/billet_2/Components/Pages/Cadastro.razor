@page "/cadastro"
@using Microsoft.AspNetCore.Components.Forms
@using billet_2.Models
@rendermode RenderMode.InteractiveServer
@inject NavigationManager Navigation
@inject billet_2.Services.PassageiroService PassageiroService
@inject billet_2.Services.AuthService AuthService

@* --- 1. BARRA DE TOPO --- *@
<nav class="navbar-top">
    <a href="/" class="brand-button">TurismoPrime</a>
</nav>

@* --- 2. CONTAINER DE CADASTRO --- *@
<div class="registration-container">
    <div class="registration-card shadow-sm">
        
        <h2 class="text-center mb-2 fw-bold" style="font-family: 'TanNimbus', sans-serif; color: #333;">Criar Conta</h2>
        <p class="text-center text-muted mb-5">Junte-se à inovação em viagens.</p>

        @if (!string.IsNullOrEmpty(mensagemErro))
        {
            <div class="alert alert-danger py-2 small">@mensagemErro</div>
        }

        @if (cadastroSucesso)
        {
            <div class="alert alert-success">Passageiro cadastrado! Redirecionando...</div>
        }
        else
        {
            <EditForm Model="passageiro" OnValidSubmit="HandleCadastro" FormName="CadastroPassageiro">
                
                <div class="mb-4">
                    <label class="form-label fw-semibold">Nome Completo</label>
                    <InputText @bind-Value="passageiro.Nome" class="form-control custom-input" placeholder="Digite seu nome" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">E-mail</label>
                    <InputText @bind-Value="passageiro.Email" type="email" class="form-control custom-input" placeholder="seu@email.com" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">CPF</label>
                    <InputText @bind-Value="passageiro.Cpf" class="form-control custom-input" placeholder="000.000.000-00" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Senha</label>
                    <InputText @bind-Value="passageiro.Senha" type="password" class="form-control custom-input" placeholder="Senha segura" />
                </div>

                <div class="mb-4 d-flex align-items-center gap-2">
                    <input type="checkbox" id="checkAdmin" @bind="isAdmin" style="width: 18px; height: 18px; cursor: pointer;" />
                    <label for="checkAdmin" class="fw-semibold m-0" style="cursor: pointer; color: #555;">Vou criar viagens</label>
                </div>

                <button type="submit" class="btn-finalizar" disabled="@carregando">
                    @(carregando ? "Processando..." : "Finalizar Cadastro")
                </button>
            </EditForm>

            <p>Já possui cadastro? <a href="/login">Clique Aqui!</a></p>
        }
    </div>
</div>

@code {
    private Passageiro passageiro = new();
    private bool isAdmin = false;
    private string mensagemErro = "";
    private bool cadastroSucesso = false;
    private bool carregando = false;
    private async Task HandleCadastro()
    {
        mensagemErro = "";

        carregando = true;

        passageiro.Adm = isAdmin;

        var erroRetornado = await PassageiroService.CadastrarAsync(passageiro);

        if (string.IsNullOrEmpty(erroRetornado))
        {
            AuthService.Logar(passageiro);
            cadastroSucesso = true;
            StateHasChanged();
            await Task.Delay(1500);
            Navigation.NavigateTo("/poslogin");
        }
        else
        {
            mensagemErro = erroRetornado;
        }

        carregando = false;
    }
}
