@page "/minhaspassagens"
@using billet_2.Models
@rendermode RenderMode.InteractiveServer
@inject NavigationManager Navigation
@inject billet_2.Services.PassagemService PassagemService
@inject billet_2.Services.ViagemService ViagemService

<div class="page-wrapper" style="align-items:flex-start; padding-top:60px;">
    <div class="page-card page-card-wide" style="max-width:720px;">
        <h2 class="page-title">Minhas Passagens</h2>

        <div style="display:flex; gap:10px; margin-bottom:28px;">
            <input type="text" @bind="cpfBusca" placeholder="Digite seu CPF" class="form-control" maxlength="14" style="flex:1;" />
            <button @onclick="BuscarPassagens" class="btn-submit" style="width:auto; padding:10px 24px;" disabled="@string.IsNullOrWhiteSpace(cpfBusca)">Buscar</button>
        </div>

        @if (estaBuscando)
        { <div class="text-center py-4"><div class="spinner"></div><p style="color:#64748B;">Buscando passagens...</p></div> }
        else if (exibirErro)
        { <div class="alert alert-danger text-center">@mensagemErro</div> }
        else if (!cpfBuscado)
        { <p style="text-align:center;color:#64748B;padding:32px 0;">Informe seu CPF para consultar suas passagens.</p> }
        else if (!passagens.Any())
        {
            <div class="text-center py-4">
                <p style="color:#64748B;">Nenhuma passagem encontrada.</p>
                <a href="/" class="btn-outline" style="display:inline-block;width:auto;margin-top:12px;padding:10px 24px;">Ver Viagens Disponiveis</a>
            </div>
        }
        else
        {
            @foreach (var passagem in passagens)
            {
                <div class="mp-ticket">
                    <div class="mp-ticket-left">
                        <span class="mp-ticket-icon">🎫</span>
                    </div>
                    <div class="mp-ticket-info">
                        <h4>@detalhesViagens[passagem.ViagemId].Origem → @detalhesViagens[passagem.ViagemId].Destino</h4>
                        <p class="mp-meta">
                            Assento @detalhesAssentos[passagem.AssentoId] •
                            @detalhesViagens[passagem.ViagemId].DataPartida.ToString("dd/MM/yyyy HH:mm")
                        </p>
                        <div class="mp-badges">
                            <span class="mp-status @GetClasseStatus(passagem.Status)">@passagem.Status.ToUpper()</span>
                            <span class="mp-date">Comprado em @passagem.DataCompra.ToString("dd/MM/yyyy")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(passagem.CupomUtilizado))
                        { <p style="font-size:.8rem;color:#95CCDD;margin-top:4px;">🎟️ Cupom: @passagem.CupomUtilizado</p> }
                    </div>
                    <div class="mp-ticket-right">
                        <span class="mp-price">R$ @passagem.PrecoPago.ToString("N2")</span>
                        @if (passagem.Status == "Ativa")
                        { <button class="mp-cancel-btn" @onclick="() => CancelarPassagem(passagem.Id)">Cancelar</button> }
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private string cpfBusca = "";
    private bool cpfBuscado = false;
    private bool estaBuscando = false;
    private bool exibirErro = false;
    private string mensagemErro = "";
    private List<Passagem> passagens = new();
    private Dictionary<int, Viagem> detalhesViagens = new();
    private Dictionary<int, string> detalhesAssentos = new();

    private async Task BuscarPassagens()
    {
        if (string.IsNullOrWhiteSpace(cpfBusca)) return;
        estaBuscando = true; exibirErro = false; StateHasChanged();
        var resultado = await PassagemService.ListarPorUsuarioAsync(cpfBusca.Trim());
        if (resultado == null) { exibirErro = true; mensagemErro = "Erro ao consultar passagens."; estaBuscando = false; return; }
        passagens = resultado; cpfBuscado = true; estaBuscando = false;
        await CarregarDetalhes();
    }

    private async Task CarregarDetalhes()
    {
        detalhesViagens.Clear(); detalhesAssentos.Clear();
        foreach (var passagem in passagens)
        {
            if (!detalhesViagens.ContainsKey(passagem.ViagemId))
            { var viagem = await ViagemService.BuscarPorIdAsync(passagem.ViagemId); if (viagem != null) detalhesViagens[passagem.ViagemId] = viagem; }
            if (!detalhesAssentos.ContainsKey(passagem.AssentoId)) detalhesAssentos[passagem.AssentoId] = $"#{passagem.AssentoId}";
        }
        StateHasChanged();
    }

    private async Task CancelarPassagem(int id) { var erro = await PassagemService.CancelarPassagemAsync(id); if (erro == null) await BuscarPassagens(); else { exibirErro = true; mensagemErro = erro; } }

    private string GetClasseStatus(string status) => status switch { "Ativa" => "status-ativa", "Cancelada" => "status-cancelada", "Utilizada" => "status-utilizada", _ => "status-cancelada" };
}
